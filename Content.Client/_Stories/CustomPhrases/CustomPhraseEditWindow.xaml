<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'stories-custom-phrases-edit-title'}"
    SetSize="420 250"
    MinSize="340 250">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6" VerticalExpand="True">
        <Label Text="{Loc 'stories-custom-phrases-text-label'}" />
        <LineEdit Name="TextEdit" PlaceHolder="{Loc 'stories-custom-phrases-text-placeholder'}" HorizontalExpand="True" />
        <Label Text="{Loc 'stories-custom-phrases-hint'}" StyleClasses="LabelSubText" />

        <Label Text="{Loc 'stories-custom-phrases-tags-label'}" />
        <LineEdit Name="TagsEdit" PlaceHolder="{Loc 'stories-custom-phrases-tags-placeholder'}" HorizontalExpand="True" />

        <Label Name="ErrorLabel" FontColorOverride="#DD4444" Visible="False" />

        <Control VerticalExpand="True" />

        <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
            <Button Name="SaveButton" Text="{Loc 'stories-custom-phrases-save'}" HorizontalExpand="True" MinHeight="30" />
            <Button Name="CancelButton" Text="{Loc 'stories-custom-phrases-cancel'}" HorizontalExpand="True" MinHeight="30" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
